    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const docData = $input.first().json;\nconst { body } = $('Resolver templateId').first().json;\n\nconst docs = (docData.data || []);\nconst found = docs.find(d => d.key === 'documento');\n\nif (!found) {\n  throw new Error('No se encontró documento con key=\"documento\" en la plantilla');\n}\n\n// Inyectar documentTemplateId en el primer elemento de documents[]\nconst enrichedBody = JSON.parse(JSON.stringify(body));\nif (enrichedBody.documents && enrichedBody.documents.length > 0) {\n  enrichedBody.documents[0].documentTemplateId = found.id;\n} else {\n  throw new Error('El body no contiene documentos');\n}\n\nreturn [{ json: enrichedBody }];"
      },
