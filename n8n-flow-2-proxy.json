        "jsCode": "// Normaliza el body según la versión de n8n.\n// En algunas versiones el webhook expone el body en $json.body;\n// en otras, $json ES el body directamente.\nconst incoming = $input.first().json;\nconst body = (incoming.body && typeof incoming.body === 'object')\n  ? incoming.body\n  : incoming;\nreturn [{ json: body }];"
