    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const templateData = $input.first().json;\nconst body = $('Merge').first().json;\n\nconst templateKey = body.templateKey;\nconst templates = (templateData.data || []);\nconst found = templates.find(t => t.key === templateKey);\n\nif (!found) {\n  throw new Error('No se encontró plantilla con key=\"' + templateKey + '\" para groupId=' + body.groupId);\n}\n\nreturn [{ json: { templateId: found.id, body } }];"
      },
