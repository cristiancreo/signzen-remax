    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const item = $input.first();\n\nif (item.error) {\n  const errMsg = item.error.message ?? JSON.stringify(item.json);\n  const match = errMsg.match(/^(\\d{3})\\s+-/);\n  const statusCode = match ? parseInt(match[1]) : 502;\n  return [{ json: { statusCode, responseBody: JSON.stringify({ error: errMsg }) } }];\n}\n\n// Éxito: item.json es la respuesta de SignZen directamente\nreturn [{ json: { statusCode: 200, responseBody: JSON.stringify(item.json) } }];"
      },
