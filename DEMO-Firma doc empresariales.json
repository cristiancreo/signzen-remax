    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n\n  // Tu JSON real\n  const step = item.json;\n  const participant = step.tasks[0];\n  const tasks = participant.tasks;\n\n  // Mapa por title (igual que tu metadata)\n  const map = {};\n  for (const t of tasks) {\n    map[t.title] = t;\n  }\n\n  // Orden FIJO\n  const orderedTasks = [\n    map[\"Notificacion\"] || null,\n    map[\"Leer recibo\"] || null,\n    map[\"Firmar Documento\"] || null\n  ].filter(Boolean);\n\n  // Reemplazamos solo el array tasks\n  participant.tasks = orderedTasks;\n\n  return { json: step };\n});\n"
      },
