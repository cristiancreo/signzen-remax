    {
      "parameters": {
        "jsCode": "// Este nodo espera que el archivo venga en la propiedad binary.data\n// Output: \n//  - base64: el archivo en base64\n//  - pdf: el archivo binario (para usarlo como PDF)\n\nconst itemsOut = [];\n\nfor (const item of items) {\n  if (!item.binary || !item.binary.data) {\n    throw new Error(\"No se encontró el archivo en binary.data\");\n  }\n\n  // Obtenemos el archivo binario\n  const file = item.binary.data;\n\n  // Convertimos el archivo a base64\n  const base64Data = file.data.toString('base64');\n\n  itemsOut.push({\n    json: {\n      base64: base64Data,  // aquí queda el base64\n    },\n    binary: {\n      pdf: {\n        data: file.data,   // binario tal cual\n        mimeType: 'application/pdf',\n        fileName: file.fileName || 'document.pdf',\n      }\n    }\n  });\n}\n\nreturn itemsOut;\n"
      },
