    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const metadata = item.json.metadata;\n\n  // Convertimos el array de metadatas a un objeto más fácil de manejar\n  const map = {};\n  for (const m of metadata) {\n    map[m.key] = m.value;\n  }\n\n  // Armamos el nuevo objeto en el orden fijo que vos querés\n  const orderedMetadata = [\n    { key: \"legajo\", value: map[\"legajo\"] || null },\n    { key: \"id documento original\", value: map[\"id documento original\"] || null },\n    { key: \"cuil\", value: map[\"cuil\"] || null },\n    { key: \"nombre_empleado\", value: map[\"nombre_empleado\"] || null },\n    { key: \"token\", value: map[\"token\"] || null }\n  ];\n\n  // Devolvemos el item con la metadata reordenada\n  return {\n    json: {\n      ...item.json,\n      metadata: orderedMetadata\n    }\n  };\n});\n\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -512,
        592
      ],
      "id": "b1b69019-c31f-4e3a-a0bf-d181998c97b1",
      "name": "Ordenar metadata"
    },
    {
      "parameters": {
        "jsCode": "return items.map(item => {\n  const workflow = item.json.workflow || [];\n\n  // Buscar el step cuyo title sea exactamente \"Empleado\"\n  const empleado = workflow.find(\n    step => step.title === \"Empleado\"\n  ) || null;\n\n  return {\n    json: {\n      title: empleado ? empleado.title : null,\n      description: empleado ? empleado.description : null,\n      dependencies: empleado?.dependencies || [],\n      type: empleado ? empleado.type : null,\n      status: empleado ? empleado.status : null,\n      startDate: empleado ? empleado.startDate : null,\n      endDate: empleado ? empleado.endDate : null,\n      id: empleado ? empleado.id : null,\n      createdAt: empleado ? empleado.createdAt : null,\n      updatedAt: empleado ? empleado.updatedAt : null\n    }\n  };\n});\n"
      },
